{
  "name": "guiatv-monorepo",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "build": "npm run build -w apps/backend && npm run build:ssr -w apps/frontend",
    "build:frontend": "npm run build:ssr -w apps/frontend",
    "build:backend": "npm run build -w apps/backend",
    "publish:release": "node scripts/publish-release.mjs",
    "check:release": "node scripts/publish-release.mjs --check",
    "start:api": "npm run start -w apps/backend",
    "start:ssr": "npm run serve:ssr -w apps/frontend",
    "dev:frontend": "npm run dev:ssr -w apps/frontend",
    "dev:backend": "npm run dev -w apps/backend",
    "job:syncEPG": "npm run job:syncEPG -w apps/backend",
    "job:precompute": "npm run job:precompute -w apps/backend",
    "job:clean": "npm run job:clean -w apps/backend",
    "migrate:social-data": "npm run migrate:social-data -w apps/backend",
    "seo:submit-sitemap": "npm run seo:submit-sitemap -w apps/backend",
    "db:bootstrap": "npm run create-indexes -w apps/backend && npm run job:syncEPG -w apps/backend && npm run job:precompute -w apps/backend",
    "deploy": "bash ./deploy-guiatv.sh",
    "test": "npm run test -w apps/backend && npm run test -w apps/frontend",
    "test:backend": "npm run test -w apps/backend",
    "test:deploy": "bash scripts/test-deploy-script.sh",
    "test:ops": "node --test scripts/uptime-probe.test.mjs scripts/post-boot-check.test.mjs scripts/workflows.test.mjs scripts/deploy-ssh.test.mjs scripts/legacy-rollout-snapshot.test.mjs scripts/editorial-cycle.test.mjs",
    "canary:probe": "node scripts/canary-legacy-probe.mjs",
    "test:frontend": "npm run test -w apps/frontend",
    "test:e2e": "playwright test",
    "lint": "npm run lint -w apps/backend && npm run lint -w apps/frontend",
    "lint:backend": "npm run lint -w apps/backend",
    "lint:frontend": "npm run lint -w apps/frontend",
    "agent:setup": "node scripts/setup-agent-environment.mjs",
    "agent:verify": "node scripts/verify-agent-environment.mjs",
    "perf:api": "node scripts/perf-http.mjs api",
    "perf:frontend": "node scripts/perf-http.mjs frontend",
    "perf:critical": "node scripts/perf-http.mjs critical",
    "cache:prewarm": "node scripts/prewarm-public-reads.mjs",
    "perf:load": "node scripts/load-http.mjs",
    "validate:tv:operational": "node scripts/validate-tv-operational.mjs",
    "seo:crawl": "node scripts/seo-crawl.mjs",
    "seo:ssr-resilience": "node scripts/seo-ssr-resilience.mjs",
    "seo:editorial-audit": "node scripts/editorial-audit.mjs",
    "seo:gsc-compare": "node scripts/gsc-compare.mjs"
  },
  "devDependencies": {
    "@angular/animations": "20.3.29",
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@playwright/test": "^1.62.1",
    "typescript": "5.8.3",
    "webpack": "5.105.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22"
  }
}
