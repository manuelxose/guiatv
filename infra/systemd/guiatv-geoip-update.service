[Unit]
Description=GuiaTV: refresh the City/ASN databases for local analytics GeoIP (MaxMind GeoLite2 with a key, else DB-IP Lite)
After=network-online.target
Wants=network-online.target
OnFailure=guiatv-crash-alert@%n.service

[Service]
Type=oneshot
# Not root (the script lives in the deploy checkout): a transient user that can write only /var/lib/GeoIP
# (StateDirectory; the API runs as root and reads it). Installed and enabled by deploy-guiatv.sh.
# systemd (PID 1, as root) reads the optional root-only MaxMind credentials file and passes it as environment;
# without it the script uses DB-IP Lite (no account).
DynamicUser=yes
StateDirectory=GeoIP
StateDirectoryMode=0755
EnvironmentFile=-/etc/guiatv/geoip.env
Environment=GEOIP_ENV_FILE=/nonexistent
Environment=GEOIP_DIR=/var/lib/GeoIP
ProtectSystem=strict
ProtectHome=yes
# The repository checkout (APP_DIR), not a release: releases carry only the built apps.
ExecStart=/var/www/guiatv/scripts/geoip-update.sh
Nice=10
CPUQuota=25%
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
TimeoutStartSec=900
