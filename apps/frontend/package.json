{
  "name": "guiatv",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/copy-maplibre-worker.mjs",
    "start": "ng serve",
    "dev:non-ssr": "node scripts/dev-server.cjs --configuration development --port 4200",
    "dev:non-ssr:open": "node scripts/dev-server.cjs --configuration development --port 4200 --open",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "ng build",
    "build:watch": "ng build --configuration development --watch --output-path=dist/guiatv",
    "serve:static": "node --max-old-space-size=8192 node_modules/browser-sync/dist/bin.js start --config bs-config.js",
    "serve:static:open": "node --max-old-space-size=8192 node_modules/browser-sync/dist/bin.js start --config bs-config.js --open",
    "prebuild:ssr": "node scripts/copy-maplibre-worker.mjs",
    "build:ssr": "ng build --configuration production --ssr",
    "serve:ssr": "node scripts/ssr-server.mjs",
    "serve:ssr:ng": "node dist/guiatv/server/main.server.mjs",
    "start:ssr": "npm run build:ssr && npm run serve:ssr",
    "dev:ssr": "node scripts/dev-server.cjs --configuration development-ssr --port 3000",
    "prerender": "ng build --prerender",
    "start:prod": "npm run build:ssr && npm run serve:ssr",
    "test": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.html\"",
    "check:sports-v2": "node scripts/check-sports-v2-isolation.mjs"
  },
  "dependencies": {
    "@angular/animations": "20.3.29",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.29",
    "@angular/compiler": "20.3.29",
    "@angular/core": "20.3.29",
    "@angular/forms": "20.3.29",
    "@angular/localize": "20.3.29",
    "@angular/platform-browser": "20.3.29",
    "@angular/platform-browser-dynamic": "20.3.29",
    "@angular/platform-server": "20.3.29",
    "@angular/router": "20.3.29",
    "@angular/ssr": "20.3.34",
    "@fontsource/inter": "^5.3.0",
    "bootstrap-icons": "^1.13.1",
    "compression": "^1.7.4",
    "domino": "^2.1.6",
    "dompurify": "^3.3.2",
    "express": "^4.21.2",
    "jsdom": "^27.2.0",
    "maplibre-gl": "^6.16.0",
    "marked": "^17.0.4",
    "ngx-device-detector": "^11.0.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.34",
    "@angular-eslint/builder": "^20.7.0",
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/cli": "20.3.34",
    "@angular/compiler-cli": "20.3.29",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.4.20",
    "browser-sync": "^3.0.4",
    "concurrently": "^8.2.0",
    "connect-history-api-fallback": "^2.0.0",
    "eslint": "^9.39.5",
    "http-proxy": "^1.18.1",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "tailwindcss": "^3.4.13",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.67.0"
  }
}
