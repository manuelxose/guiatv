SILICONFLOW_API_KEY=replace-with-your-key
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_IMAGE_MODEL=black-forest-labs/FLUX.2-pro
SILICONFLOW_IMAGE_SIZE=1024x576
SILICONFLOW_IMAGE_FORMAT=png
SILICONFLOW_DEFAULT_PROJECT=shared
SILICONFLOW_OUTPUT_DIR=generated-assets
TMDB_API_KEY=replace-in-runtime-secret-store

# Server-only football-data.org v4 credentials. Set the real value in the
# runtime secret manager/systemd EnvironmentFile; never expose it as an
# Angular environment variable or commit it here.
FOOTBALL_DATA_API_KEY=replace-in-runtime-secret-store
FOOTBALL_PROVIDER_TIMEOUT_MS=4000

# Required to approve an editorial draft for public publication. Use a long,
# independent secret and send it only in the x-editorial-review-key header.
EDITORIAL_REVIEW_KEY=replace-with-a-long-independent-review-secret
# Dedicated key and fixed reviewer identity used only by Autorio's automatic
# approval path. Keep these independent from the human review key.
AUCTORIO_EDITORIAL_REVIEW_KEY=replace-with-a-second-long-independent-secret
AUCTORIO_EDITORIAL_REVIEWER=auctorio-quality-gate
# The unattended pipeline runner's only approval right (approve-by-policy, header
# x-editorial-policy-key). Server and runner; never equal to a review key. The
# runner must never hold EDITORIAL_REVIEW_KEY (it refuses to start with it).
EDITORIAL_POLICY_KEY=replace-with-a-third-long-independent-secret

# Optional affiliate destinations. Leave blank until a commercial agreement exists.
# Each URL must use HTTPS and remain on the provider's allowlisted official host.
AFFILIATE_NETFLIX_URL=
AFFILIATE_PRIME_VIDEO_URL=
AFFILIATE_DISNEY_PLUS_URL=
AFFILIATE_MAX_URL=
AFFILIATE_MOVISTAR_PLUS_URL=
AFFILIATE_SKYSHOWTIME_URL=
AFFILIATE_APPLE_TV_PLUS_URL=
AFFILIATE_FILMIN_URL=
AFFILIATE_ATRESPLAYER_URL=
AFFILIATE_RTVE_PLAY_URL=
AFFILIATE_PLUTO_TV_URL=

# Phase 3A: read-only verified entity pages. Independent of identity ingestion; keep off in production.
CONTENT_ENTITY_PUBLIC_READ_ENABLED=false
# Phase 3B: the master flag alone serves nothing. Scope must be written out: `canary` (allowlist only) or `all`.
# Canary: allowlist file + a ceiling (1..25); kill switch = KILL=true or the KILL_FILE existing (no restart).
CONTENT_ENTITY_PUBLIC_READ_SCOPE=
CONTENT_ENTITY_CANARY_FILE=
CONTENT_ENTITY_CANARY_MAX=
CONTENT_ENTITY_KILL_FILE=
CONTENT_ENTITY_PUBLIC_READ_KILL=false
