SILICONFLOW_API_KEY=replace-with-your-key
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_IMAGE_MODEL=black-forest-labs/FLUX.2-pro
SILICONFLOW_IMAGE_SIZE=1024x576
SILICONFLOW_IMAGE_FORMAT=png
SILICONFLOW_DEFAULT_PROJECT=shared
SILICONFLOW_OUTPUT_DIR=generated-assets
TMDB_API_KEY=replace-in-runtime-secret-store

# Server-only football-data.org v4 credentials. Set the real value in the
# runtime secret manager/systemd EnvironmentFile; never expose it as an
# Angular environment variable or commit it here.
FOOTBALL_DATA_API_KEY=replace-in-runtime-secret-store
FOOTBALL_PROVIDER_TIMEOUT_MS=4000

# Server-only footballdata.io key (free plan: 1000 requests/month, 5 leagues).
# Same rule: runtime secret store only. Unset = provider not ingested.
FOOTBALLDATA_IO_API_KEY=replace-in-runtime-secret-store

# Required to approve an editorial draft for public publication. Use a long,
# independent secret and send it only in the x-editorial-review-key header.
EDITORIAL_REVIEW_KEY=replace-with-a-long-independent-review-secret
# Dedicated key and fixed reviewer identity used only by Autorio's automatic
# approval path. Keep these independent from the human review key.
AUCTORIO_EDITORIAL_REVIEW_KEY=replace-with-a-second-long-independent-secret
AUCTORIO_EDITORIAL_REVIEWER=auctorio-quality-gate
# The unattended pipeline runner's only approval right (approve-by-policy, header
# x-editorial-policy-key). Server and runner; never equal to a review key. The
# runner must never hold EDITORIAL_REVIEW_KEY (it refuses to start with it).
EDITORIAL_POLICY_KEY=replace-with-a-third-long-independent-secret

# BabyLoveGrowth article feed (https://api.babylovegrowth.ai/api/integrations). Server-only key: the hourly
# sync reads the feed once, stores the articles in Mongo and the site serves them from there.
# Unset = the sync job is skipped (no calls to the rate-limited API).
BABYLOVEGROWTH_API_KEY=replace-in-runtime-secret-store

# Auctorio article feed, same contract (default https://auctorio.com/api/integrations). Its tenant API key is the
# key Auctorio issues for this client; AUCTORIO_FEED_SITE scopes the feed to one destination site in Auctorio.
AUCTORIO_FEED_API_KEY=
AUCTORIO_FEED_BASE_URL=https://auctorio.com/api/integrations
AUCTORIO_FEED_SITE=guiatv-editorial

# Optional affiliate destinations. Leave blank until a commercial agreement exists.
# Each URL must use HTTPS and remain on the provider's allowlisted official host.
AFFILIATE_NETFLIX_URL=
AFFILIATE_PRIME_VIDEO_URL=
AFFILIATE_DISNEY_PLUS_URL=
AFFILIATE_MAX_URL=
AFFILIATE_MOVISTAR_PLUS_URL=
AFFILIATE_SKYSHOWTIME_URL=
AFFILIATE_APPLE_TV_PLUS_URL=
AFFILIATE_FILMIN_URL=
AFFILIATE_ATRESPLAYER_URL=
AFFILIATE_RTVE_PLAY_URL=
AFFILIATE_PLUTO_TV_URL=

# Phase 3A: read-only verified entity pages. Independent of identity ingestion; keep off in production.
CONTENT_ENTITY_PUBLIC_READ_ENABLED=false
# Phase 3B: the master flag alone serves nothing. Scope must be written out: `canary` (allowlist only) or `all`.
# Canary: allowlist file + a ceiling (1..25); kill switch = KILL=true or the KILL_FILE existing (no restart).
CONTENT_ENTITY_PUBLIC_READ_SCOPE=
CONTENT_ENTITY_CANARY_FILE=
CONTENT_ENTITY_CANARY_MAX=
CONTENT_ENTITY_KILL_FILE=
CONTENT_ENTITY_PUBLIC_READ_KILL=false

# Analytics (Mongo): comma-separated client IPs excluded from reports, including
# the administrator's public IP and the production server's public IP.
ANALYTICS_EXCLUDED_IPS=
# Exact IP addresses of proxies that append X-Forwarded-For for Analytics.
# Default (empty): the local nginx on loopback (127.0.0.1, ::1), which appends the real peer address.
ANALYTICS_TRUSTED_PROXIES=
# Exact socket addresses of trusted proxies that overwrite or remove CF-IPCountry
# and CF-Region-Code on every request. Leave empty if that cannot be guaranteed.
ANALYTICS_GEO_TRUSTED_PROXIES=
# Exact socket addresses (also listed above) that overwrite or remove CF-IPCity,
# CF-IPLatitude and CF-IPLongitude on every request. Coordinates are rounded to
# 0.1 degrees and identify an approximate IP location, not an exact user position.
ANALYTICS_GEO_DETAIL_TRUSTED_PROXIES=

# --- Analytics collection (ANALYTICS-01..06) ---------------------------------------------------------------
# Emergency switch, re-read every 5 s without restart: ANALYTICS_INGEST_ENABLED=false or create the kill file.
# Browsers learn it from GET /v2/telemetry/config within ~60 s and stop collecting.
ANALYTICS_INGEST_ENABLED=true
ANALYTICS_KILL_FILE=/etc/guiatv/analytics.kill
# Pre-consent legacy endpoints (/session/*, /event) keep their response contract but persist nothing unless "accept".
ANALYTICS_LEGACY_ENDPOINTS=drop
# Stored client address: "anonymized" (IPv4 /24, IPv6 /48 prefix; default) or "none" (no address, user agent or location).
ANALYTICS_PII=anonymized
# Ingestion queue bounds (batches / events) and per-IP rate of POST /v2/telemetry/collect.
ANALYTICS_QUEUE_MAX_BATCHES=5000
ANALYTICS_QUEUE_MAX_EVENTS=50000
ANALYTICS_COLLECT_RATE_PER_MIN=240
# Local MaxMind GeoLite2 enrichment (files installed by scripts/geoip-update.sh; credentials in /etc/guiatv/geoip.env).
ANALYTICS_GEOIP_ENABLED=false
ANALYTICS_GEOIP_CITY_DB=/var/lib/GeoIP/GeoLite2-City.mmdb
ANALYTICS_GEOIP_ASN_DB=/var/lib/GeoIP/GeoLite2-ASN.mmdb
# GA4 (loaded in the browser only after analytics consent). Off until the property is verified.
ANALYTICS_GA4_ENABLED=false
ANALYTICS_GA4_MEASUREMENT_ID=G-P6Z3BY2DVW
# GA4 Data API for aggregate admin reports (read-only service account with the GA4 "Viewer" role; file outside the repo).
ANALYTICS_GA4_PROPERTY_ID=
ANALYTICS_GA4_CREDENTIALS_FILE=/etc/guiatv/ga4-reader.json
